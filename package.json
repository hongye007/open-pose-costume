{
  "name": "open-pose-costume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5199 --strictPort",
    "sync": "node scripts/sync.mjs",
    "images:download": "node scripts/download-images.mjs",
    "data:build": "node scripts/build-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "worker:types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc",
    "worker:check": "npm run worker:types && tsc -p worker/tsconfig.json && wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "server:start": "node server/index.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.156.1"
  }
}
